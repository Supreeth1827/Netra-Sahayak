<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY - overrides app/src/main/res/xml/network_security_config.xml.

  Allows plain http so the app can talk to a FastAPI server running on:
    - 10.0.2.2      (the development machine, as seen from the emulator)
    - localhost / 127.0.0.1
    - any LAN address such as 192.168.x.x when testing on a real phone

  Release builds use the strict main/ version and require HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
